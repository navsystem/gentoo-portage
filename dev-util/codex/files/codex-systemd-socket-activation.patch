+#[cfg(unix)]
+fn take_systemd_listener() -> IoResult<Option<UnixListener>> {
+    use std::os::fd::FromRawFd;
+
+    let Some(listen_pid) = std::env::var_os("LISTEN_PID") else {
+        return Ok(None);
+    };
+    let listen_pid = listen_pid.to_str().and_then(|value| value.parse::<u32>().ok());
+    if listen_pid != Some(std::process::id()) {
+        return Ok(None);
+    }
+    let listen_fds = std::env::var("LISTEN_FDS")
+        .ok()
+        .and_then(|value| value.parse::<u32>().ok())
+        .ok_or_else(|| {
+            std::io::Error::new(
+                ErrorKind::InvalidInput,
+                "systemd LISTEN_FDS is missing or invalid",
+            )
+        })?;
+    if listen_fds != 1 {
+        return Err(std::io::Error::new(
+            ErrorKind::InvalidInput,
+            format!("expected one systemd listener fd, got {listen_fds}"),
+        ));
+    }
+
+    // systemd places the first socket-activated listener at fd 3.
+    let listener = unsafe { std::os::unix::net::UnixListener::from_raw_fd(3) };
+    codex_uds::UnixListener::from_std(listener).map(Some)
+}
+
+#[cfg(not(unix))]
+fn take_systemd_listener() -> IoResult<Option<UnixListener>> {
+    Ok(None)
+}
